# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع ملف .env نفسه إلى GitHub أبداً.
# (npm run setup ينشئه لك، و .env مستثنى في .gitignore.)
# كل القيم تُفحص عند الإقلاع، وكل المشاكل تظهر معاً في رسالة واحدة.

NODE_ENV=development
PORT=3000

# سر مشترك لمسارات المالك فقط (يُرسل في ترويسة X-Api-Key).
# 32 حرفاً عشوائياً على الأقل، مثلاً: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_KEY=change-me-to-a-long-random-string
# أثناء تغيير المفتاح: المفتاح القديم (أو عدة مفاتيح مفصولة بفواصل) يبقى مقبولاً حتى تحدّث كل أدواتك.
OWNER_API_KEY_PREVIOUS=

# يوقّع توكنات الدخول (32 حرفاً عشوائياً على الأقل). غيّره مع وضع القديم في PREVIOUS حتى لا يخرج الجميع.
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET_PREVIOUS=

# debug | info | warn | error
LOG_LEVEL=info
# pretty (للطرفية) | json (لأدوات جمع السجلات). الافتراضي json عندما NODE_ENV=production.
LOG_FORMAT=pretty

# المواقع المسموح لها باستدعاء الـ API من المتصفح: "*" أو موقع أو عدة مواقع مفصولة بفواصل.
CORS_ORIGIN=*
# true فقط إن كان التطبيق خلف Reverse proxy واحد موثوق (مثل nginx)، فيأخذ حد المحاولات
# العنوان من X-Forwarded-For. اتركه false في غير ذلك، لأن العميل يستطيع تزوير هذه الترويسة.
TRUST_PROXY=false

# بادئة نسخة الـ API، مثل /v1 (فارغة = بلا بادئة). /health و /metrics تبقى من الجذر.
API_BASE_PATH=
# أقصى حجم لجسم الطلب بالبايت (الافتراضي 1048576 = 1 ميغابايت).
BODY_LIMIT_BYTES=1048576
# عملة المتجر (ISO 4217). كل المبالغ أرقام صحيحة بأصغر وحدة فيها (الدينار = 1000 درهم).
CURRENCY=LYD

DATABASE_URL=postgresql://user:password@localhost:5432/commerce_dev
# مجموعة الاتصالات: الحجم، وأقصى مدة لاستعلام، وأقصى مدة لمعاملة خاملة، ومهلة الاتصال (بالملي ثانية).
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# إن وُضع: GET /metrics يتطلب Authorization: Bearer <القيمة>. (أو احجب /metrics عن الإنترنت في الـ proxy.)
METRICS_TOKEN=
# كم ننتظر الطلبات الجارية عند الإيقاف (SIGTERM) قبل قطعها.
SHUTDOWN_TIMEOUT_MS=10000
# خلف موازن أحمال: كم ننتظر بعد أن يصبح /readyz 503 وقبل رفض الاتصالات (مثلاً 5000).
SHUTDOWN_DELAY_MS=0
# Strict-Transport-Security: فعّله فقط إن كان الموقع خلف HTTPS.
HSTS=false

# قاعدة منفصلة لاختبارات التكامل: الاختبارات تمسح جداولها، فلا تشر بها أبداً إلى بيانات حقيقية.
# (الاختبارات ترفض العمل إلا على قاعدة يحتوي اسمها كلمة test.)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/commerce_test
