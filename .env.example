# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=3000

# Single shared secret for owner-only routes (sent as the X-Api-Key header).
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_KEY=change-me-to-a-long-random-string

# Signs customer login tokens (at least 32 random characters). Changing it logs every customer out.
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

LOG_LEVEL=info

# Origin allowed to call the API from a browser (the demo store's URL in production).
CORS_ORIGIN=*
# true ONLY when running behind one trusted reverse proxy (e.g. nginx); it makes the
# login rate limit use X-Forwarded-For. Leave false otherwise (the header is forgeable).
TRUST_PROXY=false

DATABASE_URL=postgresql://user:password@localhost:5432/commerce_dev

# Separate database for integration tests - tests wipe their tables, never point this at real data.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/commerce_test
