PORT=3000
# At least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info
CORS_ORIGIN=*
# true ONLY when running behind one trusted reverse proxy (e.g. nginx); it makes the
# login rate limit use X-Forwarded-For. Leave false otherwise (the header is forgeable).
TRUST_PROXY=false

# A separate database for the demo (create it first).
DATABASE_URL=postgresql://user:password@localhost:5432/commerce_demo
