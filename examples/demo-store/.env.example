PORT=3000
# 32 حرفاً عشوائياً على الأقل لكل منهما. لتوليد قيمة:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info
CORS_ORIGIN=*
# true فقط إن كان التطبيق خلف Reverse proxy واحد موثوق (مثل nginx)، فيأخذ حد محاولات الدخول
# العنوان من X-Forwarded-For. اتركه false في غير ذلك، لأن العميل يستطيع تزوير هذه الترويسة.
TRUST_PROXY=false

# قاعدة بيانات منفصلة للمتجر التجريبي (أنشئها أولاً).
DATABASE_URL=postgresql://user:password@localhost:5432/commerce_demo
