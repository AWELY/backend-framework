require("dotenv").config({ quiet: true });
const {
  loadConfig,
  createCommerceApp,
  optionsFromConfig,
  installShutdownHandlers,
  cashOnDelivery,
  flatRateShipping,
  coupons,
} = require("maa");

/**
 * __PROJECT_NAME__: متجر مبني على إطار maa.
 *
 * optionsFromConfig تحوّل إعدادات .env (المفحوصة عند الإقلاع) إلى خيارات التطبيق، وأنت تضيف فوقها
 * ما يخص متجرك: الإضافات، وجدول الصلاحيات، وحدود المحاولات...
 */
async function main() {
  const config = loadConfig();
  const app = createCommerceApp({
    ...optionsFromConfig(config),
    plugins: [
      cashOnDelivery(),
      flatRateShipping({ rate: 10000, freeOver: 200000 }), // 10 دنانير، ومجاني فوق 200 دينار
      coupons(),
    ],
  });
  await app.listen(config.port);
  // Ctrl+C أو SIGTERM (Docker): الطلبات الجارية تكتمل، ثم يُغلق كل شيء بترتيب.
  installShutdownHandlers(app, { timeoutMs: config.shutdownTimeoutMs });
  app.logger.info(`__PROJECT_NAME__ listening on port ${config.port}`);
}

main().catch((err) => {
  console.error(err instanceof Error ? err.message : err);
  process.exitCode = 1;
});
