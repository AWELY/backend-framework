require("dotenv").config({ quiet: true });
const {
  loadConfig,
  Logger,
  createCommerceApp,
  cashOnDelivery,
  flatRateShipping,
} = require("commerce-framework");

// The whole store API: categories, products, inventory, customers, carts and
// orders, with auth, validation, logging and error handling, comes from
// createCommerceApp. Run `npm run migrate` once before the first start.
async function main() {
  const config = loadConfig();
  const logger = new Logger(config.logLevel);
  const app = createCommerceApp({
    databaseUrl: config.databaseUrl,
    ownerApiKey: config.ownerApiKey,
    authTokenSecret: config.authTokenSecret,
    corsOrigin: config.corsOrigin,
    trustProxy: config.trustProxy,
    logger,
    // Plugins: payment and shipping methods offered at checkout.
    // Amounts are in the smallest currency unit (1 LYD = 1000 dirhams).
    plugins: [
      cashOnDelivery(),
      flatRateShipping({ rate: 10000, freeOver: 200000 }), // 10 LYD, free over 200 LYD
    ],
  });
  await app.listen(config.port);
  logger.info(`__PROJECT_NAME__ listening on port ${config.port}`);
}

main().catch((err) => {
  console.error(err);
  process.exitCode = 1;
});
