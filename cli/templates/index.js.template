require("dotenv").config({ quiet: true });
const {
  loadConfig,
  Logger,
  createCommerceApp,
  cashOnDelivery,
  flatRateShipping,
} = require("commerce-framework");

// الـ API الكامل للمتجر يأتي من createCommerceApp: الأقسام، والمنتجات، والمخزون، والزبائن،
// والسلال، والطلبات، مع المصادقة، والتحقق من المدخلات، والسجل، ومعالجة الأخطاء.
// شغّل npm run migrate مرة واحدة قبل أول تشغيل.
async function main() {
  const config = loadConfig();
  const logger = new Logger(config.logLevel);
  const app = createCommerceApp({
    databaseUrl: config.databaseUrl,
    ownerApiKey: config.ownerApiKey,
    authTokenSecret: config.authTokenSecret,
    corsOrigin: config.corsOrigin,
    trustProxy: config.trustProxy,
    logger,
    // الإضافات: طرق الدفع والشحن التي تظهر عند إتمام الشراء.
    // المبالغ بأصغر وحدة للعملة (1 دينار = 1000 درهم).
    plugins: [
      cashOnDelivery(),
      flatRateShipping({ rate: 10000, freeOver: 200000 }), // 10 دنانير، ومجاني فوق 200 دينار
    ],
  });
  await app.listen(config.port);
  logger.info(`__PROJECT_NAME__ listening on port ${config.port}`);
}

main().catch((err) => {
  console.error(err);
  process.exitCode = 1;
});
