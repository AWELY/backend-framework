require("dotenv").config({ quiet: true });
const { loadConfig, createCommerceApp, optionsFromConfig, cashOnDelivery, flatRateShipping, coupons } = require("maa");

/**
 * يطبّق جداول الإطار والوحدات والإضافات التي لم تُطبَّق بعد (آمن عند التكرار).
 * الإضافات هنا نفسها التي في index.js، لأن بعضها له جداول (مثل coupons).
 */
async function main() {
  const config = loadConfig();
  const app = createCommerceApp({
    ...optionsFromConfig(config),
    workers: false,
    plugins: [cashOnDelivery(), flatRateShipping({ rate: 10000 }), coupons()],
  });
  try {
    const applied = await app.migrate();
    console.log(applied.length ? `Done: ${applied.length} migration(s) applied.` : "Database is already up to date.");
  } finally {
    await app.pool.end();
  }
}

main().catch((err) => {
  console.error(err instanceof Error ? err.message : err);
  process.exitCode = 1;
});
