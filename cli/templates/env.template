PORT=3000
# Owner key (X-Api-Key header) and the customer-token signing secret: at least 32 random characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info
CORS_ORIGIN=*
# true ONLY when running behind one trusted reverse proxy (e.g. nginx); it makes the
# login rate limit use X-Forwarded-For. Leave false otherwise (the header is forgeable).
TRUST_PROXY=false

# The store's PostgreSQL database (create it first, then run `npm run migrate`).
DATABASE_URL=postgresql://user:password@localhost:5432/__PROJECT_NAME__
