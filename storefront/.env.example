# ---- AMA store API (built on commerce-framework) ----
PORT=3000
# At least 32 random characters each. `npm run setup` fills them for you.
OWNER_API_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info
# The website's address - only this origin may call the API from a browser.
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# The store's own database (create it first - see README.md).
DATABASE_URL=postgresql://commerce_app:password@localhost:5432/ama_store

# ---- Website ----
WEB_PORT=5173
