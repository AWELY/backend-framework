# ---- الـ API الخاص بمتجر ماء (مبني على maa) ----
# انسخ هذا الملف إلى .env، أو شغّل npm run setup فيُنشئه لك بأسرار عشوائية.
PORT=3000
# 32 حرفاً عشوائياً على الأقل لكل منهما. الأمر npm run setup يملؤهما لك.
OWNER_API_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info
# عنوان الموقع: هذا الموقع وحده يُسمح له باستدعاء الـ API من المتصفح (CORS).
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# قاعدة بيانات المتجر نفسه (أنشئها أولاً، انظر README.md).
DATABASE_URL=postgresql://commerce_app:password@localhost:5432/ama_store

# ---- الموقع ----
WEB_PORT=5173

# صندوق بريد التطوير (GET /dev/mailbox) وبوابة البطاقة التجريبية. false في الإنتاج.
DEMO_MODE=true
# سر توقيع webhook البوابة التجريبية (اختياري: يُشتق من AUTH_TOKEN_SECRET إن تُرك فارغاً).
DEMO_GATEWAY_SECRET=
