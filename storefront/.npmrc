# الإطار اعتمادية من نوع "file:.." في package.json (المجلد الأعلى).
# install-links=true تجعل npm يحزم الإطار ويثبته نسخة حقيقية في node_modules، تماماً كما لو
# نُزّل من سجل npm (فقط الملفات المنشورة: dist و cli)، بدل اختصار (symlink) إلى مجلد الإطار.
# فائدته: المتجر يستخدم الإطار كأي مستخدم خارجي. ونتيجته: بعد تعديل الإطار وبنائه (npm run build)،
# يجب npm install هنا من جديد ليصل التعديل (سكربت verify يفعل ذلك تلقائياً).
install-links=true
