{
  "name": "maa",
  "version": "1.0.0",
  "description": "Maa: a production-ready, modular backend framework for headless e-commerce on Node.js, TypeScript and a single PostgreSQL database.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "maa": "cli/index.js"
  },
  "files": [
    "dist",
    "cli",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/dev-server.js",
    "dev:build": "tsc --watch",
    "dev:run": "node --watch dist/dev-server.js",
    "cli": "node cli/index.js",
    "migrate": "node dist/migrate.js",
    "bench": "node bench/run.js",
    "verify": "node scripts/verify.js",
    "setup": "node scripts/setup-env.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"build-test/tests/**/*.test.js\"",
    "lint": "node scripts/lint.js",
    "openapi": "node scripts/openapi.js",
    "openapi:check": "node scripts/openapi.js --check",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"build-test/src/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=75 \"build-test/tests/**/*.test.js\"",
    "check": "npm run lint && npm run build && npm run openapi:check && npm run test:coverage"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "ecommerce",
    "headless",
    "framework",
    "postgresql",
    "typescript",
    "nodejs",
    "rest",
    "api"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^18.0.3",
    "pg": "^8.23.0"
  }
}
